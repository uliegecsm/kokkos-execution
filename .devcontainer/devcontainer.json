{
    "dockerFile": "dockerfile",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cmake-tools",
                "ms-vscode.cpptools",
                "eamodio.gitlens",
                "mhutchie.git-graph",
                "ms-azuretools.vscode-docker",
                "ms-python.python"
            ]
        }
    },
    "runArgs": [
        "--privileged"
    ],
    "remoteEnv": {
        "CCACHE_DIR" : "${containerWorkspaceFolder}/.ccache/",
        "CCACHE_MAXSIZE" : "15G"
    },
    "onCreateCommand": "git config --global --add safe.directory $PWD && pre-commit install"
}
