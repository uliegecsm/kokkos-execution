{
    "version": 10,
    "configurePresets": [
        {
            "$comment": "Configuration common to all available presets.",
            "name": "default",
            "hidden": true,
            "binaryDir": "${sourceDir}/build-with-${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_STANDARD": "20",
                "CMAKE_CXX_EXTENSIONS": "OFF",
                "BUILD_SHARED_LIBS": "ON",
                "CMAKE_C_COMPILER": "should-not-be-needed",
                "Kokkos_ENABLE_SERIAL": "ON",
                "Kokkos_ENABLE_TESTS": "OFF"
            }
        },
        {
            "$comment": "Use GNU for host code.",
            "name": "cxx-gnu",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "$comment": "Use Clang for host code.",
            "name": "cxx-clang",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "$comment": "Use ROCm for host and device code.",
            "name": "cxx-hip-rocm",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "hipcc"
            }
        },
        {
            "$comment": "Use GNU for host code and nvcc for device code.",
            "name": "cxx-cuda-gnu-nvidia",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "${sourceDir}/bin/nvcc_wrapper"
            }
        },
        {
            "$comment": "Use Clang for host and device code.",
            "name": "cxx-cuda-clang",
            "hidden": true,
            "inherits": ["cxx-clang"]
        },
        {
            "$comment": "Inherit from this preset to use the OpenMP backend.",
            "name": "OpenMP",
            "hidden": true,
            "cacheVariables": {
                "Kokkos_ENABLE_OPENMP": "ON"
            }
        },
        {
            "$comment": "Inherit from this preset to use the Cuda backend.",
            "name": "Cuda",
            "hidden": true,
            "cacheVariables": {
                "Kokkos_ENABLE_CUDA": "ON",
                "Kokkos_ENABLE_CUDA_CONSTEXPR": "ON",
                "Kokkos_ENABLE_IMPL_CUDA_MALLOC_ASYNC": "ON"
            }
        },
        {
            "$comment": "Inherit from this preset to use the HIP backend.",
            "name": "HIP",
            "hidden": true,
            "cacheVariables": {
                "Kokkos_ENABLE_HIP": "ON",
                "Kokkos_ENABLE_ROCTHRUST": "OFF",
                "Kokkos_ENABLE_IMPL_HIP_MALLOC_ASYNC": "ON"
            }
        },
        {
            "name": "gnu-OpenMP",
            "inherits": ["default", "cxx-gnu", "OpenMP"]
        },
        {
            "name": "clang-OpenMP",
            "inherits": ["default", "cxx-clang", "OpenMP"]
        },
        {
            "name": "gnu-nvidia-OpenMP-Cuda",
            "inherits": ["default", "cxx-cuda-gnu-nvidia", "OpenMP", "Cuda"]
        },
        {
            "name": "clang-OpenMP-Cuda",
            "inherits": ["default", "cxx-cuda-clang", "OpenMP", "Cuda"]
        },
        {
            "name": "rocm-OpenMP-HIP",
            "inherits": ["default", "cxx-hip-rocm", "OpenMP", "HIP"]
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "inheritConfigureEnvironment": true
        },
        {
            "name": "gnu-OpenMP",
            "configurePreset": "gnu-OpenMP",
            "inherits": "default"
        },
        {
            "name": "clang-OpenMP",
            "configurePreset": "clang-OpenMP",
            "inherits": "default"
        },
        {
            "name": "clang-OpenMP-Cuda",
            "configurePreset": "clang-OpenMP-Cuda",
            "inherits": "default"
        },
        {
            "name": "gnu-nvidia-OpenMP-Cuda",
            "configurePreset": "gnu-nvidia-OpenMP-Cuda",
            "inherits": "default"
        },
        {
            "name": "rocm-OpenMP-HIP",
            "configurePreset": "rocm-OpenMP-HIP",
            "inherits": "default"
        }
    ]
}
