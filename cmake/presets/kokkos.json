{
    "version": 10,
    "configurePresets": [
        {
            "$comment": "Configuration common to all available presets.",
            "name": "default",
            "hidden": true,
            "binaryDir": "${sourceDir}/build-with-${presetName}",
            "cacheVariables": {
                "CMAKE_CXX_STANDARD": "20",
                "CMAKE_CXX_EXTENSIONS": "OFF",
                "BUILD_SHARED_LIBS": "ON",
                "CMAKE_C_COMPILER": "should-not-be-needed",
                "Kokkos_ENABLE_SERIAL": "ON",
                "Kokkos_ENABLE_TESTS": "OFF"
            }
        },
        {
            "$comment": "Use GNU for host code.",
            "name": "cxx-gnu",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "$comment": "Use Clang for host code.",
            "name": "cxx-clang",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "$comment": "Use ROCm for host and device code.",
            "name": "cxx-hip-rocm",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "hipcc"
            }
        },
        {
            "$comment": "Use Clang for host and device code.",
            "name": "cxx-cuda-clang",
            "hidden": true,
            "inherits": ["cxx-clang"]
        },
        {
            "$comment": "Inherit from this preset to use the Threads backend.",
            "name": "Threads",
            "hidden": true,
            "cacheVariables": {
                "Kokkos_ENABLE_THREADS": "ON"
            }
        },
        {
            "$comment": "Inherit from this preset to use the OpenMP backend.",
            "name": "OpenMP",
            "hidden": true,
            "cacheVariables": {
                "Kokkos_ENABLE_OPENMP": "ON"
            }
        },
        {
            "$comment": "Inherit from this preset to use the HPX backend.",
            "name": "HPX",
            "hidden": true,
            "cacheVariables": {
                "Kokkos_ENABLE_HPX": "ON"
            }
        },
        {
            "$comment": "Inherit from this preset to use the Cuda backend.",
            "name": "Cuda",
            "hidden": true,
            "cacheVariables": {
                "Kokkos_ENABLE_CUDA": "ON",
                "Kokkos_ENABLE_CUDA_CONSTEXPR": "ON",
                "Kokkos_ENABLE_IMPL_CUDA_MALLOC_ASYNC": "ON"
            }
        },
        {
            "$comment": "Inherit from this preset to use the HIP backend.",
            "name": "HIP",
            "hidden": true,
            "cacheVariables": {
                "Kokkos_ENABLE_HIP": "ON",
                "Kokkos_ENABLE_ROCTHRUST": "OFF",
                "Kokkos_ENABLE_IMPL_HIP_MALLOC_ASYNC": "ON"
            }
        },
        {
            "$comment": "Inherit from this preset to use the Intel compiler family.",
            "name": "intel",
            "hidden": true,
            "cacheVariables": {"CMAKE_CXX_COMPILER" : "icpx"}
        },
        {
            "name" : "SYCL",
            "hidden" : true,
            "cacheVariables" : {
                "Kokkos_ENABLE_SYCL" : "ON"
            }
        },
        {
            "name": "fix-latomic",
            "hidden": true,
            "environment": {
                "$comment": "https://github.com/kokkos/kokkos/issues/8977",
                "LDFLAGS": "-latomic"
            }
        },
        {
            "name": "gnu",
            "inherits": ["default", "cxx-gnu"]
        },
        {
            "name": "gnu-Threads",
            "inherits": ["default", "cxx-gnu", "Threads"]
        },
        {
            "name": "gnu-OpenMP",
            "inherits": ["default", "cxx-gnu", "OpenMP"]
        },
        {
            "name": "clang-OpenMP",
            "inherits": ["default", "cxx-clang", "OpenMP"]
        },
        {
            "name": "gnu-HPX",
            "inherits": ["default", "cxx-gnu", "HPX"]
        },
        {
            "name": "clang-HPX",
            "inherits": ["default", "cxx-clang", "HPX", "fix-latomic"]
        },
        {
            "name": "clang-OpenMP-Cuda",
            "inherits": ["default", "cxx-cuda-clang", "OpenMP", "Cuda"]
        },
        {
            "name": "clang-HPX-Cuda",
            "inherits": ["default", "cxx-cuda-clang", "HPX", "Cuda", "fix-latomic"]
        },
        {
            "name": "rocm-OpenMP-HIP",
            "inherits": ["default", "cxx-hip-rocm", "OpenMP", "HIP"]
        },
        {
            "name"     : "intel-OpenMP-SYCL",
            "inherits" : ["default", "intel", "OpenMP", "SYCL"],
            "cacheVariables" : {
                "$comment": "RDC is enabled because of https://github.com/uliegecsm/kokkos-execution/pull/114#issuecomment-4153192133. It requires building static libs.",
                "Kokkos_ENABLE_SYCL_RELOCATABLE_DEVICE_CODE": "ON",
                "BUILD_SHARED_LIBS": "OFF",
                "Kokkos_ENABLE_ONEDPL" : "OFF",
                "Kokkos_ENABLE_UNSUPPORTED_ARCHS" : "ON",
                "CMAKE_CXX_FLAGS" : "-fp-model=precise"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "inheritConfigureEnvironment": true
        },
        {
            "name": "gnu",
            "configurePreset": "gnu",
            "inherits": "default"
        },
        {
            "name": "gnu-Threads",
            "configurePreset": "gnu-Threads",
            "inherits": "default"
        },
        {
            "name": "gnu-OpenMP",
            "configurePreset": "gnu-OpenMP",
            "inherits": "default"
        },
        {
            "name": "clang-OpenMP",
            "configurePreset": "clang-OpenMP",
            "inherits": "default"
        },
        {
            "name": "gnu-HPX",
            "configurePreset": "gnu-HPX",
            "inherits": "default"
        },
        {
            "name": "clang-HPX",
            "configurePreset": "clang-HPX",
            "inherits": "default"
        },
        {
            "name": "clang-OpenMP-Cuda",
            "configurePreset": "clang-OpenMP-Cuda",
            "inherits": "default"
        },
        {
            "name": "clang-HPX-Cuda",
            "configurePreset": "clang-HPX-Cuda",
            "inherits": "default"
        },
        {
            "name": "rocm-OpenMP-HIP",
            "configurePreset": "rocm-OpenMP-HIP",
            "inherits": "default"
        },
        {
            "name": "intel-OpenMP-SYCL",
            "configurePreset": "intel-OpenMP-SYCL",
            "inherits": "default"
        }
    ]
}
