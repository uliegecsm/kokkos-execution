{
    "version": 10,
    "configurePresets": [
        {
            "$comment": "Configuration common to all available presets.",
            "name": "default",
            "hidden": true,
            "binaryDir": "${sourceDir}/build-with-${presetName}",
            "cacheVariables": {
                "CMAKE_CXX_STANDARD": "20",
                "CMAKE_CXX_EXTENSIONS": "OFF",
                "CMAKE_C_COMPILER": "should-not-be-needed",
                "KokkosUtils_ENABLE_TESTS": "OFF",
                "KokkosUtils_ENABLE_DOC": "OFF"
            }
        },
        {
            "$comment": "Use GNU for host code.",
            "name": "cxx-gnu",
            "hidden": true,
            "cacheVariables": {"CMAKE_CXX_COMPILER": "g++"}
        },
        {
            "$comment": "Use clang for host code.",
            "name": "cxx-clang",
            "hidden": true,
            "cacheVariables": {"CMAKE_CXX_COMPILER": "clang++"}
        },
        {
            "$comment": "Use ROCm for host and device code.",
            "name": "cxx-hip-rocm",
            "hidden": true,
            "cacheVariables": {"CMAKE_CXX_COMPILER": "hipcc"}
        },
        {
            "$comment": "Inherit from this preset to use the Intel compiler family.",
            "name": "cxx-intel",
            "hidden": true,
            "cacheVariables": {"CMAKE_CXX_COMPILER" : "icpx"}
        },
        {
            "$comment": "Use Clang for host and device code.",
            "name": "cxx-cuda-clang",
            "hidden": true,
            "inherits": ["cxx-clang"]
        },
        {
            "name": "gnu",
            "inherits": ["default", "cxx-gnu"]
        },
        {
            "name": "gnu-Threads",
            "inherits": ["default", "cxx-gnu"]
        },
        {
            "name": "gnu-OpenMP",
            "inherits": ["default", "cxx-gnu"]
        },
        {
            "name": "clang-OpenMP",
            "inherits": ["default", "cxx-clang"]
        },
        {
            "name": "gnu-HPX",
            "inherits": ["default", "cxx-gnu"]
        },
        {
            "name": "clang-HPX",
            "inherits": ["default", "cxx-clang"]
        },
        {
            "name": "clang-OpenMP-Cuda",
            "inherits": ["default", "cxx-cuda-clang"]
        },
        {
            "name": "clang-HPX-Cuda",
            "inherits": ["default", "cxx-cuda-clang"]
        },
        {
            "name": "rocm-OpenMP-HIP",
            "inherits": ["default", "cxx-hip-rocm"]
        },
        {
            "name": "intel-OpenMP-SYCL",
            "inherits": ["default", "cxx-intel"]
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "inheritConfigureEnvironment": true
        },
        {
            "name": "gnu",
            "configurePreset": "gnu",
            "inherits": "default"
        },
        {
            "name": "gnu-Threads",
            "configurePreset": "gnu-Threads",
            "inherits": "default"
        },
        {
            "name": "gnu-OpenMP",
            "configurePreset": "gnu-OpenMP",
            "inherits": "default"
        },
        {
            "name": "clang-OpenMP",
            "configurePreset": "clang-OpenMP",
            "inherits": "default"
        },
        {
            "name": "gnu-HPX",
            "configurePreset": "gnu-HPX",
            "inherits": "default"
        },
        {
            "name": "clang-HPX",
            "configurePreset": "clang-HPX",
            "inherits": "default"
        },
        {
            "name": "clang-OpenMP-Cuda",
            "configurePreset": "clang-OpenMP-Cuda",
            "inherits": "default"
        },
        {
            "name": "clang-HPX-Cuda",
            "configurePreset": "clang-HPX-Cuda",
            "inherits": "default"
        },
        {
            "name": "rocm-OpenMP-HIP",
            "configurePreset": "rocm-OpenMP-HIP",
            "inherits": "default"
        },
        {
            "name": "intel-OpenMP-SYCL",
            "configurePreset": "intel-OpenMP-SYCL",
            "inherits": "default"
        }
    ]
}
