+++ core/unit_test/hpx/TestHPX_DefaultInstanceFencesOnFinalize.cpp
@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+// SPDX-FileCopyrightText: Copyright Contributors to the Kokkos project
+
+#include <Kokkos_Macros.hpp>
+#ifdef KOKKOS_ENABLE_EXPERIMENTAL_CXX20_MODULES
+import kokkos.core;
+#else
+#include <Kokkos_Core.hpp>
+#endif
+#include <TestHPX_Category.hpp>
+
+namespace Test {
+
+struct NoOp {
+  template <std::integral T>
+  KOKKOS_FUNCTION void operator()(T) const {}
+};
+
+// Test whether the HPX default instance fences on finalize.
+TEST(hpx, default_instance_fences_on_finalize) {
+  const Kokkos::Experimental::HPX exec{};
+
+  Kokkos::parallel_for(Kokkos::RangePolicy(exec, 0, 1), NoOp{});
+}
+}  // namespace Test
