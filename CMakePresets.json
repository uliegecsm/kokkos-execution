{
    "version": 10,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "binaryDir": "${sourceDir}/build-with-${presetName}",
            "warnings": {
                "dev": true,
                "uninitialized": true,
                "unusedCli": true,
                "deprecated": true
            },
            "cacheVariables": {
                "CMAKE_CXX_STANDARD": "20",
                "CMAKE_CXX_STANDARD_REQUIRED": "ON",
                "KokkosExecution_ENABLE_EXAMPLES": "ON",
                "KokkosExecution_ENABLE_TESTS": "ON"
            }
        },
        {
            "name": "cxx-ccache",
            "hidden": true,
            "cacheVariables": {"CMAKE_CXX_COMPILER_LAUNCHER": "ccache"}
        },
        {
            "name": "cxx-gnu",
            "hidden": true,
            "inherits": "cxx-ccache",
            "cacheVariables": {"CMAKE_CXX_COMPILER": "g++"}
        },
        {
            "name": "cxx-clang",
            "hidden": true,
            "inherits": "cxx-ccache",
            "cacheVariables": {"CMAKE_CXX_COMPILER": "clang++"}
        },
        {
            "name": "cxx-intel",
            "hidden": true,
            "inherits": "cxx-ccache",
            "cacheVariables": {"CMAKE_CXX_COMPILER": "icpx"}
        },
        {
            "name": "clang-tidy",
            "hidden": true,
            "inherits": "cxx-ccache",
            "cacheVariables": {"KokkosExecution_ENABLE_CLANG_TIDY" : "ON"}
        },
        {
            "name": "cxx-hip-rocm",
            "hidden": true,
            "inherits": "cxx-ccache",
            "cacheVariables": {"CMAKE_CXX_COMPILER": "hipcc"}
        },
        {
            "name": "gnu",
            "inherits": ["default", "cxx-gnu"]
        },
        {
            "name": "gnu-Threads",
            "inherits": ["default", "cxx-gnu"]
        },
        {
            "name": "gnu-OpenMP",
            "inherits": ["default", "cxx-gnu"],
            "cacheVariables": {"KokkosExecution_ENABLE_DEBUG_LOGGING": "ON"}
        },
        {
            "name": "clang-OpenMP",
            "inherits": ["default", "cxx-clang", "clang-tidy"]
        },
        {
            "name": "gnu-HPX",
            "inherits": ["default", "cxx-gnu"]
        },
        {
            "name": "clang-HPX",
            "inherits": ["default", "cxx-clang"]
        },
        {
            "name": "clang-OpenMP-Cuda",
            "inherits": ["default", "cxx-clang", "clang-tidy"]
        },
        {
            "name": "clang-HPX-Cuda",
            "inherits": ["default", "cxx-clang", "clang-tidy"]
        },
        {
            "name": "rocm-OpenMP-HIP",
            "inherits": ["default", "cxx-hip-rocm"]
        },
        {
            "name": "intel-OpenMP-SYCL",
            "inherits": ["default", "cxx-intel"]
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "inheritConfigureEnvironment": true
        },
        {
            "name": "gnu",
            "configurePreset": "gnu",
            "inherits": "default"
        },
        {
            "name": "gnu-Threads",
            "configurePreset": "gnu-Threads",
            "inherits": "default"
        },
        {
            "name": "gnu-OpenMP",
            "configurePreset": "gnu-OpenMP",
            "inherits": "default"
        },
        {
            "name": "gnu-HPX",
            "configurePreset": "gnu-HPX",
            "inherits": "default"
        },
        {
            "name": "clang-OpenMP",
            "configurePreset": "clang-OpenMP",
            "inherits": "default"
        },
        {
            "name": "clang-HPX",
            "configurePreset": "clang-HPX",
            "inherits": "default"
        },
        {
            "name": "clang-OpenMP-Cuda",
            "configurePreset": "clang-OpenMP-Cuda",
            "inherits": "default"
        },
        {
            "name": "clang-HPX-Cuda",
            "configurePreset": "clang-HPX-Cuda",
            "inherits": "default"
        },
        {
            "name": "rocm-OpenMP-HIP",
            "configurePreset": "rocm-OpenMP-HIP",
            "inherits": "default"
        },
        {
            "name": "intel-OpenMP-SYCL",
            "configurePreset": "intel-OpenMP-SYCL",
            "inherits": "default"
        }
    ],
    "testPresets": [
        {
            "name": "default",
            "hidden": true,
            "configurePreset": "default",
            "inheritConfigureEnvironment": true,
            "output": {"outputOnFailure": true},
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": false,
                "scheduleRandom": true
            }
        },
        {
            "name": "gnu",
            "configurePreset": "gnu",
            "inherits": "default"
        },
        {
            "name": "gnu-Threads",
            "configurePreset": "gnu-Threads",
            "inherits": "default"
        },
        {
            "name": "gnu-OpenMP",
            "configurePreset": "gnu-OpenMP",
            "inherits": "default"
        },
        {
            "name": "clang-OpenMP",
            "configurePreset": "clang-OpenMP",
            "inherits": "default"
        },
        {
            "name": "gnu-HPX",
            "configurePreset": "gnu-HPX",
            "inherits": "default"
        },
        {
            "name": "clang-HPX",
            "configurePreset": "clang-HPX",
            "inherits": "default"
        },
        {
            "name": "clang-OpenMP-Cuda",
            "configurePreset": "clang-OpenMP-Cuda",
            "inherits": "default"
        },
        {
            "name": "clang-HPX-Cuda",
            "configurePreset": "clang-HPX-Cuda",
            "inherits": "default"
        },
        {
            "name": "rocm-OpenMP-HIP",
            "configurePreset": "rocm-OpenMP-HIP",
            "inherits": "default"
        },
        {
            "name": "intel-OpenMP-SYCL",
            "configurePreset": "intel-OpenMP-SYCL",
            "inherits": "default"
        }
    ]
}
