From d6d88eaff28d8814ab3c32db9668eddff85a6856 Mon Sep 17 00:00:00 2001
From: Maarten Arnst <maarten.arnst@uliege.be>
Date: Tue, 10 Nov 2026 11:48:48 +0100
Subject: [PATCH] Fix composed to allow non-uniqueness

Signed-off-by: Maarten Arnst <maarten.arnst@uliege.be>
---
 include/stdexec/functional.hpp            | 15 +++++++++------
 test/stdexec/algos/adaptors/test_then.cpp | 11 +++++++++++
 2 files changed, 20 insertions(+), 6 deletions(-)

diff --git a/include/stdexec/functional.hpp b/include/stdexec/functional.hpp
index e4bf8b7b..34ab1c3e 100644
--- a/include/stdexec/functional.hpp
+++ b/include/stdexec/functional.hpp
@@ -37,8 +37,6 @@ namespace STDEXEC
 {
   template <class _Fun0, class _Fun1>
   struct STDEXEC_ATTRIBUTE(empty_bases) __composed
-    : _Fun0
-    , _Fun1
   {
     // clang-format off
     template <class _Self, class... _Ts>
@@ -46,12 +44,17 @@ namespace STDEXEC
             && __callable<__copy_cvref_t<_Self, _Fun0>,
                           __call_result_t<__copy_cvref_t<_Self, _Fun1>, _Ts...>>
     STDEXEC_ATTRIBUTE(host, device, always_inline)
-    constexpr STDEXEC_EXPLICIT_THIS_BEGIN(auto operator())(this _Self &&__self, _Ts &&...__ts)
+    constexpr STDEXEC_EXPLICIT_THIS_BEGIN(auto operator())(
+      this _Self &&__self, _Ts &&...__ts)
       STDEXEC_AUTO_RETURN(
-        static_cast<__copy_cvref_t<_Self, _Fun0> &&>(__self)(
-          static_cast<__copy_cvref_t<_Self, _Fun1> &&>(__self)(static_cast<_Ts &&>(__ts)...)))
+        static_cast<_Self &&>(__self).__t0_(
+          static_cast<_Self &&>(__self).__t1_(
+            static_cast<_Ts &&>(__ts)...)))
     STDEXEC_EXPLICIT_THIS_END(operator())
-    // clang-format on
+      // clang-format on
+
+      STDEXEC_ATTRIBUTE(no_unique_address) _Fun0 __t0_;
+    STDEXEC_ATTRIBUTE(no_unique_address) _Fun1 __t1_;
   };
 
   template <class _Fun0, class _Fun1>
diff --git a/test/stdexec/algos/adaptors/test_then.cpp b/test/stdexec/algos/adaptors/test_then.cpp
index 1292d522..2226c3aa 100644
--- a/test/stdexec/algos/adaptors/test_then.cpp
+++ b/test/stdexec/algos/adaptors/test_then.cpp
@@ -57,6 +57,17 @@ namespace
     CHECK(called);
   }
 
+  struct Functor
+  {
+    void operator()() const {}
+  };
+
+  TEST_CASE("then adaptors of the same type can be composed", "[adaptors][then]")
+  {
+    auto closure = STDEXEC::then(Functor{}) | STDEXEC::then(Functor{});
+    STDEXEC::sync_wait(STDEXEC::just() | closure);
+  }
+
   TEST_CASE("then can be piped", "[adaptors][then]")
   {
     ex::sender auto snd = ex::just() | ex::then([] {});
-- 
