From 818d1a194ffe912473b1e0c44f332b4b3b217c6c Mon Sep 17 00:00:00 2001
From: Maarten Arnst <maarten.arnst@uliege.be>
Date: Mon, 12 Oct 2026 21:30:29 +0200
Subject: [PATCH] stdexec icpx ice when all patch

---
 include/stdexec/__detail/__when_all.hpp | 25 +++++++++++++++++++------
 1 file changed, 19 insertions(+), 6 deletions(-)

diff --git a/include/stdexec/__detail/__when_all.hpp b/include/stdexec/__detail/__when_all.hpp
index 7d7770e7..9fc0794f 100644
--- a/include/stdexec/__detail/__when_all.hpp
+++ b/include/stdexec/__detail/__when_all.hpp
@@ -517,15 +517,28 @@ namespace STDEXEC
       using __f = __completions<__env_t<_Env, _Senders...>>::template __f<_Senders...>;
     };
 
+    template <class _Receiver>
+    struct __set_values_fn
+    {
+      _Receiver& __rcvr_;
+
+      template <class... _OptTuples>
+      STDEXEC_ATTRIBUTE(host, device)
+      constexpr void operator()(_OptTuples&&... __opt_vals) const noexcept
+      {
+        STDEXEC::__cat_apply(
+          __mk_completion_fn(set_value, __rcvr_),
+          *static_cast<_OptTuples&&>(__opt_vals)...);
+      }
+    };
+
     template <class _Receiver, class _ValuesTuple>
-    constexpr void __set_values(_Receiver& __rcvr, _ValuesTuple& __values) noexcept
+    constexpr void __set_values(
+      _Receiver& __rcvr,
+      _ValuesTuple& __values) noexcept
     {
       STDEXEC::__apply(
-        [&]<class... OptTuples>(OptTuples&&... __opt_vals) noexcept -> void
-        {
-          STDEXEC::__cat_apply(__mk_completion_fn(set_value, __rcvr),
-                               *static_cast<OptTuples&&>(__opt_vals)...);
-        },
+        __set_values_fn<_Receiver>{__rcvr},
         static_cast<_ValuesTuple&&>(__values));
     }
 
