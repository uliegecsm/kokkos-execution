From 330d6ce6c00b4e303497fc7a7a69711ae4943507 Mon Sep 17 00:00:00 2001
From: romintomasetti <romin.tomasetti@gmail.com>
Date: Thu, 26 Nov 2026 11:47:45 +0000
Subject: [PATCH] async deallocation to reduce amount of synchronization

Signed-off-by: romintomasetti <romin.tomasetti@gmail.com>
---
 cmake/KokkosCore_config.h.in        |  2 ++
 cmake/kokkos_enable_options.cmake   |  3 +++
 core/src/Cuda/Kokkos_Cuda.hpp       |  4 ++++
 core/src/Cuda/Kokkos_CudaSpace.cpp  |  8 ++++++++
 core/src/Cuda/Kokkos_CudaSpace.hpp  | 10 ++++++++++
 core/src/HIP/Kokkos_HIP.hpp         |  4 ++++
 core/src/HIP/Kokkos_HIP_Space.cpp   |  2 ++
 core/src/HIP/Kokkos_HIP_Space.hpp   | 10 ++++++++++
 core/src/HPX/Kokkos_HPX.hpp         |  4 ++++
 core/src/Kokkos_HostSpace.hpp       |  4 ++++
 core/src/OpenMP/Kokkos_OpenMP.hpp   |  4 ++++
 core/src/SYCL/Kokkos_SYCL.hpp       |  4 ++++
 core/src/SYCL/Kokkos_SYCL_Space.cpp |  2 ++
 core/src/SYCL/Kokkos_SYCL_Space.hpp | 12 ++++++++++++
 core/src/Serial/Kokkos_Serial.hpp   |  4 ++++
 core/src/Threads/Kokkos_Threads.hpp |  4 ++++
 core/src/View/Kokkos_ViewAlloc.hpp  | 25 ++++++++++++++++++++++++-
 core/src/impl/Kokkos_HostSpace.cpp  |  4 ++++
 18 files changed, 109 insertions(+), 1 deletion(-)

diff --git a/cmake/KokkosCore_config.h.in b/cmake/KokkosCore_config.h.in
index 2d9d708f2..bdb3f9fb6 100644
--- a/cmake/KokkosCore_config.h.in
+++ b/cmake/KokkosCore_config.h.in
@@ -36,6 +36,8 @@
 #cmakedefine KOKKOS_ENABLE_CXX23
 #cmakedefine KOKKOS_ENABLE_CXX26
 
+#cmakedefine KOKKOS_ENABLE_IMPL_ASYNC
+
 #cmakedefine KOKKOS_ENABLE_CUDA_RELOCATABLE_DEVICE_CODE
 #cmakedefine KOKKOS_ENABLE_CUDA_CONSTEXPR
 #cmakedefine KOKKOS_ENABLE_IMPL_CUDA_MALLOC_ASYNC
diff --git a/cmake/kokkos_enable_options.cmake b/cmake/kokkos_enable_options.cmake
index dc7c865a1..65ad8aeef 100644
--- a/cmake/kokkos_enable_options.cmake
+++ b/cmake/kokkos_enable_options.cmake
@@ -22,6 +22,9 @@ endfunction()
 kokkos_cfg_depends(OPTIONS DEVICES)
 kokkos_cfg_depends(OPTIONS COMPILER_ID)
 
+# Reducing the amount of synchronization induced by Kokkos requires better programming patterns on the user side.
+kokkos_enable_option(IMPL_ASYNC OFF "Reduce synchronizations")
+
 # Put a check in just in case people are using this option
 kokkos_deprecated_list(OPTIONS ENABLE)
 
diff --git a/core/src/Cuda/Kokkos_Cuda.hpp b/core/src/Cuda/Kokkos_Cuda.hpp
index 4c96e47b9..46d248f77 100644
--- a/core/src/Cuda/Kokkos_Cuda.hpp
+++ b/core/src/Cuda/Kokkos_Cuda.hpp
@@ -117,6 +117,10 @@ class Cuda {
   /** \brief  Return the maximum amount of concurrency.  */
   int concurrency() const;
 
+#if defined(KOKKOS_ENABLE_IMPL_ASYNC)
+  static constexpr bool supports_async_dispatch() noexcept { return true; }
+#endif
+
   //! Print configuration information to the given output stream.
   void print_configuration(std::ostream& os, bool verbose = false) const;
 
diff --git a/core/src/Cuda/Kokkos_CudaSpace.cpp b/core/src/Cuda/Kokkos_CudaSpace.cpp
index b49bb52bb..c2239d15b 100644
--- a/core/src/Cuda/Kokkos_CudaSpace.cpp
+++ b/core/src/Cuda/Kokkos_CudaSpace.cpp
@@ -361,12 +361,16 @@ void CudaSpace::impl_deallocate(
   KOKKOS_IMPL_CUDA_SAFE_CALL(cudaFree(arg_alloc_ptr));
 #elif (defined(KOKKOS_ENABLE_IMPL_CUDA_MALLOC_ASYNC) && CUDART_VERSION >= 11020)
   if (arg_alloc_size >= memory_threshold_g) {
+#if !defined(KOKKOS_ENABLE_IMPL_ASYNC)
     Impl::cuda_device_synchronize(
         "Kokkos::Cuda: backend fence before async free");
+#endif
     KOKKOS_IMPL_CUDA_SAFE_CALL(cudaSetDevice(m_device));
     KOKKOS_IMPL_CUDA_SAFE_CALL(cudaFreeAsync(arg_alloc_ptr, m_stream));
+#if !defined(KOKKOS_ENABLE_IMPL_ASYNC)
     Impl::cuda_device_synchronize(
         "Kokkos::Cuda: backend fence after async free");
+#endif
   } else {
     KOKKOS_IMPL_CUDA_SAFE_CALL(cudaSetDevice(m_device));
     KOKKOS_IMPL_CUDA_SAFE_CALL(cudaFree(arg_alloc_ptr));
@@ -396,8 +400,10 @@ void CudaUVMSpace::impl_deallocate(
     const char *arg_label, void *const arg_alloc_ptr,
     const size_t /*arg_alloc_size*/, const size_t arg_reported_size,
     const Kokkos::Tools::SpaceHandle arg_handle) const {
+#if !defined(KOKKOS_ENABLE_IMPL_ASYNC)
   Cuda::impl_static_fence(
       "Kokkos::CudaUVMSpace::impl_deallocate: Pre UVM Deallocation");
+#endif
   if (Kokkos::Profiling::profileLibraryLoaded()) {
     Kokkos::Profiling::deallocateData(arg_handle, arg_label, arg_alloc_ptr,
                                       arg_reported_size);
@@ -406,8 +412,10 @@ void CudaUVMSpace::impl_deallocate(
     KOKKOS_IMPL_CUDA_SAFE_CALL(cudaSetDevice(m_device));
     KOKKOS_IMPL_CUDA_SAFE_CALL(cudaFree(arg_alloc_ptr));
   }
+#if !defined(KOKKOS_ENABLE_IMPL_ASYNC)
   Cuda::impl_static_fence(
       "Kokkos::CudaUVMSpace::impl_deallocate: Post UVM Deallocation");
+#endif
 }
 
 void CudaHostPinnedSpace::deallocate(void *const arg_alloc_ptr,
